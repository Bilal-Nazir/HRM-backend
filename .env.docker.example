# Copy to .env.docker (ignored by Git). Never commit filled-in secrets.
# Local test only; on a public server use your DNS hostname, e.g. hrm.example.com.
SITE_ADDRESS=http://localhost
# Generate a DIFFERENT hex secret for each field: openssl rand -hex 32
# Hex avoids Mongo URI and Compose interpolation escaping problems.
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
# Initial account admin-001; minimum 12 characters, never a shared default.
INITIAL_ADMIN_PASSWORD=
