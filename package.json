{
  "name": "hrm-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "build/app.js",
  "scripts": {
    "dev": "tsc-watch --noClear -p ./tsconfig.json --onSuccess \"node --import=extensionless/register build/app.js\"",
    "build": "rimraf build && tsc -p .",
    "start": "node --import=extensionless/register build/app.js",
    "test:workspace": "tsc -p . --outDir tmp/workspace-test-build && node --import=extensionless/register --test --test-force-exit --test-timeout=60000 tests/workspace.test.mjs"
  },
  "dependencies": {
    "@typegoose/typegoose": "^12.11.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-winston": "^4.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "redis": "^4.7.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.4",
    "extensionless": "^1.9.9",
    "prettier": "^3.9.9",
    "rimraf": "^6.0.1",
    "tsc-watch": "^7.1.1",
    "typescript": "^5.7.3"
  }
}
